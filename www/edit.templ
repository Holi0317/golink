package www

import (
	"github.com/holi0317/golink/server/db"
)

// Edit renders the form to change a link's target URL. The slug itself is
// fixed: renaming would break published links; delete and recreate instead.
templ Edit(link db.Link) {
	@Layout("edit “"+link.Slug+"” — golink", editContent(link))
}

templ editContent(link db.Link) {
	<h2>Edit go link <code>{ link.Slug }</code></h2>
	<form method="post" action={ editURL(link.ID) }>
		<label for="target_url">Target URL</label>
		<input id="target_url" name="target_url" type="url" value={ link.TargetUrl } required/>
		<button type="submit">Save</button>
	</form>
	<p>
		<a href="/_/">Back to all links</a> ·
		<a href={ deleteURL(link.ID) }>Delete this link</a>
	</p>
}
