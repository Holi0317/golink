package www

import (
	"github.com/holi0317/golink/db/generated"
)

// Index lists every link with its slug and target URL, and carries the
// create form at the top. Everyone can edit every link (blind trust).
// prefilledSlug, when non-empty, seeds the create form's slug field — it
// comes from the 404 page's "create" button via ?slug=….
templ Index(links []db.Link, prefilledSlug string) {
	@Layout("golink — settings", indexContent(links, prefilledSlug))
}

templ indexContent(links []db.Link, prefilledSlug string) {
	<h2>Create a go link</h2>
	<form method="post" action="/_/">
		<label for="slug">Slug</label>
		<input id="slug" name="slug" required placeholder="greet" pattern="[^/]+" value={ prefilledSlug }/>
		<label for="target_url">Target URL</label>
		<input id="target_url" name="target_url" type="url" required placeholder="https://example.com/hello"/>
		<p>{ templateHint }</p>
		<label for="default_url">Default location (template links only)</label>
		<input id="default_url" name="default_url" type="url" placeholder="https://corp.atlassian.com/board"/>
		<p>{ defaultHint }</p>
		<button type="submit">Create</button>
	</form>

	<h2>All go links</h2>
	<table>
		<tr>
			<th>Slug</th>
			<th>Goes to</th>
			<th>Updated</th>
			<th>Actions</th>
		</tr>
		for _, link := range links {
			<tr>
				<td>{ link.Slug }</td>
				<td>{ link.TargetUrl }</td>
				<td>{ link.UpdatedAt.UTC().Format("2006-01-02 15:04 MST") }</td>
				<td>
					<a href={ editURL(link.ID) }>Edit</a>
					<a href={ deleteURL(link.ID) }>Delete</a>
				</td>
			</tr>
		}
	</table>
}
